# Production environment variables
# Copy this to .env.production and update with your actual API URL

# Option A: API on different domain/subdomain (requires CORS in Django)
VITE_API_BASE_URL=https://api.tudominio.com/api/v1

# Option B: Same domain via reverse proxy (nginx) - uncomment and comment above
# VITE_API_BASE_URL=/api/v1